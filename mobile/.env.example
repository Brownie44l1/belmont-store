# Copy to .env and fill in real values. Never commit .env.
# Only public values belong here: Expo inlines EXPO_PUBLIC_* into the app bundle.
# Never put server secrets (Supabase service-role key, Mailgun keys) in the mobile app.

# Base URL of the deployed Next.js API (no trailing slash).
EXPO_PUBLIC_API_BASE_URL=https://belmont-store.vercel.app

# Supabase project (same project as the web app).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
